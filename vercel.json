{
  "redirects": [
    {
      "source": "/solucoes",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/landing",
      "destination": "/apresentacao",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "find-gamma-ten.vercel.app" }],
      "destination": "https://www.onefind.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "find-onefind.vercel.app" }],
      "destination": "https://www.onefind.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "find-landingpage.vercel.app" }],
      "destination": "https://www.onefind.com.br/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|favicon\\.svg|google.*\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
